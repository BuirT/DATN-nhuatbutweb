# Cổng chạy Server Backend
PORT=5000

# Chìa khóa mã hóa JWT
JWT_SECRET=dien_chia_khoa_vao_day

# ========================================================
# CẤU HÌNH KẾT NỐI SQL SERVER CHUNG TOÀN NHÓM
# ========================================================

# LƯU Ý KHI DÙNG RADMIN VPN:
# 1. Các thành viên phải tải và cài đặt Radmin VPN, join vào cùng một Network với máy chủ (Máy chứa SQL Server).
# 2. Bạn phải mở Radmin VPN, xem địa chỉ IP (dãy số dạng 26.x.x.x) của máy chủ chứa Database.
# 3. Điền IP đó vào biến DB_SERVER bên dưới. Không dùng 'localhost' nếu bạn đang chạy máy trạm!
# 4. Hãy chắc chắn Firewall của máy chủ đã mở port 1433 cho kết nối SQL Server.

DB_SERVER=26.x.x.x              # IP Radmin của máy chủ chứa CSDL (Nếu chạy chung máy chứa DB thì điền localhost)
DB_USER=sa                      # Tài khoản đăng nhập SQL Server (thường là sa)
DB_PASSWORD=nhap_mat_khau_sql   # Mật khẩu tài khoản sa
DB_NAME=DATNnhuanbut            # Tên CSDL (Bắt buộc dùng chung tên này để khớp với Winform)
DB_PORT=1433                    # Port mặc định của SQL Server (đảm bảo máy chủ đã Enable TCP/IP trong SQL Configuration Manager)